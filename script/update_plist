#!/bin/bash
#
# Updates the Info.plist file for a macOS app bundle to register terminal folder handling and URL schemes.
# This only applies the updates common to `script/bundle` and `script/run`.
# Must be called from the root directory of the warp repo.

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'HELP'
Usage: script/update_plist [-h|--help]

Update the macOS bundle Info.plist specified by WARP_PLIST_PATH.
Optional environment: WARP_SCHEME_NAME, WARP_DISPLAY_NAME, GIT_RELEASE_TAG,
and WARP_PLIST_NO_FILE_TYPES (set to omit folder registration).
HELP
  exit 0
fi

if [[ ! -d "script" ]]; then
    echo "Run this script from the root of your warp repo."
    exit 1
fi

if [[ -z "${WARP_PLIST_PATH:-}" ]]; then
  echo 'Must set $WARP_PLIST_PATH'
  exit 1
fi

if [[ -n "${GIT_RELEASE_TAG:-}" ]]; then
  echo "Updating plist Warp version to $GIT_RELEASE_TAG"
  plutil -replace WarpVersion -string "${GIT_RELEASE_TAG:-}" "${WARP_PLIST_PATH:-}"

  # Bundle version fields use numbers. WarpVersion preserves the full release tag.
  # Accept Warper semantic versions and inherited timestamp tags.
  if [[ $GIT_RELEASE_TAG =~ ^warper-v([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
    FORMATTED_VERSION="${BASH_REMATCH[1]}"
    plutil -replace CFBundleShortVersionString -string "$FORMATTED_VERSION" "${WARP_PLIST_PATH:-}"
    plutil -replace CFBundleVersion -string "$FORMATTED_VERSION" "${WARP_PLIST_PATH:-}"
  elif [[ $GIT_RELEASE_TAG =~ ^v([0-9]+)\.([0-9]{4})\.([0-9]{2})\.([0-9]{2})\.([0-9]{2})\.([0-9]{2})\.[a-z]+_([0-9]{2})$ ]]; then
    MAJOR="${BASH_REMATCH[1]}"
    YEAR="${BASH_REMATCH[2]}"
    MONTH="${BASH_REMATCH[3]}"
    DAY="${BASH_REMATCH[4]}"
    HOUR="${BASH_REMATCH[5]}"
    MINUTE="${BASH_REMATCH[6]}"
    BUILD="${BASH_REMATCH[7]}"
    
    FORMATTED_VERSION="${MAJOR}.${YEAR}.${MONTH}.${DAY}.${HOUR}.${MINUTE}.${BUILD}"
    
    echo "Updating plist version to $FORMATTED_VERSION"
    plutil -replace CFBundleShortVersionString -string "$FORMATTED_VERSION" "${WARP_PLIST_PATH:-}"
    plutil -replace CFBundleVersion -string "$FORMATTED_VERSION" "${WARP_PLIST_PATH:-}"
  else
    echo "Warning: GIT_RELEASE_TAG '$GIT_RELEASE_TAG' is not a Warper version tag or upstream timestamp tag"
  fi
fi

if [[ -n "${WARP_SCHEME_NAME:-}" ]]; then
  echo "Updating plist to support a custom url scheme"
  # Update the plist that cargo bundle creates to add support for custom URL schemes. Unfortunately, cargo bundle does not support
  # setting arbitrary plist fields, so we must do this after the fact.
  plutil -replace CFBundleURLTypes -xml "<array><dict><key>CFBundleURLName</key><string>Custom App</string><key>CFBundleURLSchemes</key><array><string>$WARP_SCHEME_NAME</string></array></dict></array>" "${WARP_PLIST_PATH:-}"
fi

if [[ -z "${WARP_PLIST_NO_FILE_TYPES:-}" ]]; then
  echo "Updating plist with terminal folder handling"
  plutil -replace CFBundleDocumentTypes -xml "
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>Folder</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.folder</string>
      </array>
    </dict>
  </array>" "${WARP_PLIST_PATH:-}"
fi

echo "Updating plist with permissions descriptions"
APP_DISPLAY_NAME="${WARP_DISPLAY_NAME:-Warp}"
plutil -replace NSAppleEventsUsageDescription -string "A program in $APP_DISPLAY_NAME wants to use AppleScript." "${WARP_PLIST_PATH:-}"
plutil -replace NSCameraUsageDescription -string "A program in $APP_DISPLAY_NAME wants to use the camera." "${WARP_PLIST_PATH:-}"
plutil -replace NSMicrophoneUsageDescription -string "A program in $APP_DISPLAY_NAME wants to use your microphone." "${WARP_PLIST_PATH:-}"
plutil -replace NSContactsUsageDescription -string "A program in $APP_DISPLAY_NAME wants to use your contacts." "${WARP_PLIST_PATH:-}"
plutil -replace NSCalendarsUsageDescription -string "A program in $APP_DISPLAY_NAME wants to use your calendar." "${WARP_PLIST_PATH:-}"
plutil -replace NSLocationUsageDescription -string "A program in $APP_DISPLAY_NAME wants to use your location information." "${WARP_PLIST_PATH:-}"
plutil -replace NSPhotoLibraryUsageDescription -string "A program in $APP_DISPLAY_NAME wants to use your photo library." "${WARP_PLIST_PATH:-}"

echo "Disabling use of Liquid Glass on macOS Tahoe"
plutil -replace UIDesignRequiresCompatibility -bool true "${WARP_PLIST_PATH:-}"
